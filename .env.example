# Copia este archivo como .env.local y llena los valores.
# Salen de Firebase Console → Configuración del proyecto → Tus apps → Config.
# .env.local no se sube al repo (está cubierto por *.local en .gitignore).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
