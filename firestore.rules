rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function householdPath(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }

    function isMember(hid) {
      return signedIn() && request.auth.uid in get(householdPath(hid)).data.memberIds;
    }

    // ---- Hogares -----------------------------------------------------------
    match /households/{hid} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      // Quien crea el hogar queda como dueño y único miembro.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;

      // Un miembro puede cambiar el nombre o marcar la migración, pero no
      // tocar quién es dueño ni quiénes son miembros.
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.members == resource.data.members;

      // Alguien de afuera solo puede agregarse a sí mismo, con un código
      // válido de este hogar que se marca como usado en la misma escritura.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && validJoin(hid);

      allow delete: if false;

      function validJoin(hid) {
        let code = request.resource.data.lastInviteCode;
        let invitePath = /databases/$(database)/documents/invites/$(code);
        let invite = get(invitePath).data;
        let membersDiff = request.resource.data.members.diff(resource.data.members);
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberIds', 'members', 'lastInviteCode'])
          && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
          && membersDiff.addedKeys().hasOnly([request.auth.uid])
          && membersDiff.changedKeys().size() == 0
          && membersDiff.removedKeys().size() == 0
          && exists(invitePath)
          && invite.householdId == hid
          && invite.usedBy == null
          && invite.expiresAt > request.time
          && getAfter(invitePath).data.usedBy == request.auth.uid;
      }

      // Datos del hogar: solo miembros.
      match /items/{id} {
        allow read, write: if isMember(hid);
      }
      match /payments/{id} {
        allow read, write: if isMember(hid);
      }
      match /gmailImports/{id} {
        allow read, write: if isMember(hid);
      }
    }

    // ---- Invitaciones ------------------------------------------------------
    // El código es el ID del documento. Se puede leer uno conociendo el código,
    // pero no listar la colección.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && code.size() == 8
        && isMember(request.resource.data.householdId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.usedBy == null
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(49, 'h');

      // Marcar como usado: solo quien entra al hogar en la misma escritura.
      allow update: if signedIn()
        && resource.data.usedBy == null
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && request.auth.uid in getAfter(householdPath(resource.data.householdId)).data.memberIds;

      // Un miembro del hogar puede anular un código.
      allow delete: if isMember(resource.data.householdId);
    }

    // ---- Datos anteriores (transición) -------------------------------------
    // Antes de nov-2026 los datos estaban en la raíz. Quedan en solo lectura
    // para las dos cuentas originales mientras se confirma la copia al hogar.
    // Cuando esté confirmada, estas tres reglas se pueden quitar.
    function isLegacyUser() {
      return signedIn() && request.auth.token.email in [
        "ricardoarjona028@gmail.com",
        "jeragui10@gmail.com"
      ];
    }
    match /items/{id}        { allow read: if isLegacyUser(); }
    match /payments/{id}     { allow read: if isLegacyUser(); }
    match /gmailImports/{id} { allow read: if isLegacyUser(); }

    // Todo lo demás: bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
